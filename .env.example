# Copy to .env and uncomment what you want to change. run-phostt-server.(bat|sh)
# loads it automatically. See "Configuration" in README.md for details.

# HOST=0.0.0.0
# PORT=8123
# SSL_CERTFILE=cert.pem
# SSL_KEYFILE=key.pem
# MODEL_DIR=models
# NUM_THREADS=4
# PROVIDER=cpu
# DECODING_METHOD=modified_beam_search
# MAX_ACTIVE_PATHS=8
# VAD_THRESHOLD=0.3
# HOTWORDS_FILE=hotwords.txt
# HOTWORDS_SCORE=2.0
# TEXT_CASE=lower
# FFMPEG_BIN=
# STREAM_UPDATE_SECONDS=1.0
# STREAM_WINDOW_SECONDS=10.0
